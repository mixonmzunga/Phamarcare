# ===========================================
# PharmaCare - Supabase Configuration
# ===========================================
# Copy these values from your Supabase project dashboard:
# Settings → API → Project URL and anon/service_role keys
# Settings → Database → Connection string

# --- Database (Prisma) ---
# Use the "Transaction" connection pooler URL from Supabase → Settings → Database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Use the "Session" connection string (direct connection, no pooling)
# From Supabase → Settings → Database → Connection string → URI
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- Supabase API ---
# From Supabase → Settings → API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# --- Auth secret (for session signing) ---
AUTH_SECRET="pharmacare-prod-secret-change-this-9f2k4"
