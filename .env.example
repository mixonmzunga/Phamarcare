# ===========================================
# PharmaCare - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# OR set these as environment variables in your deployment platform

# --- Database (Prisma) ---
# Supabase PostgreSQL connection string (Session Pooler)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase API ---
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# --- Auth secret (for session signing) ---
AUTH_SECRET="pharmacare-prod-secret-change-this"
